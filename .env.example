# ==============================================================================
# UpFront — Open Source Privacy Analytics & Consent Management Platform (CMP)
# Environment Configuration Template
# Copy this file to .env and adjust the values according to your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# PostgreSQL database connection string.
# Supports standard PostgreSQL, TimescaleDB, or Supabase.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/upfront

# ------------------------------------------------------------------------------
# 2. WEB APPLICATION & SERVER
# ------------------------------------------------------------------------------
# Base URL where the UpFront dashboard and tracker scripts are hosted.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server port for Next.js web application
PORT=3000

# ------------------------------------------------------------------------------
# 3. BACKEND API (FastAPI Ingestion & Stats Engine)
# ------------------------------------------------------------------------------
# Base URL for the analytics ingestion and processing microservice (apps/api)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Secret salt used for privacy-safe daily visitor hashing.
# Change this to a secure random string in production!
HASH_SALT=upfront_super_privacy_salt_change_me_in_production

# ------------------------------------------------------------------------------
# 4. OPEN SOURCE & COMMUNITY REPOSITORY
# ------------------------------------------------------------------------------
# GitHub repository URL displayed on the Star button and documentation links
NEXT_PUBLIC_GITHUB_REPO_URL=https://github.com/Abishekram03/usrly

# ------------------------------------------------------------------------------
# 5. AUTOMATED SCANNER & CRAWLER (OPTIONAL)
# ------------------------------------------------------------------------------
# Set to 'true' if running Playwright crawler in Docker or root environment without sandboxing
PLAYWRIGHT_NO_SANDBOX=false

# Secret authorization key for triggering scheduled scanner cron jobs (/api/v1/cron/scheduled-scans)
CRON_SECRET=upfront_cron_secret_key_change_me

# ------------------------------------------------------------------------------
# 6. OBSERVABILITY & ERROR TRACKING (OPTIONAL)
# ------------------------------------------------------------------------------
# Sentry DSN for client/server error monitoring (optional)
# NEXT_PUBLIC_SENTRY_DSN=
